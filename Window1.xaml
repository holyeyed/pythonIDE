<Window x:Class="PythonEditor.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Project python Mới" Height="284" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15,15,15,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="272.04"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Project Folder Name -->
        <Label Content="Tên thư mục:" VerticalAlignment="Top" Height="30" Margin="0,9,300,0"/>
        <TextBox x:Name="txtProjectName" VerticalContentAlignment="Center" Margin="120,8,0,0" Height="30" VerticalAlignment="Top"/>

        <!-- App Name -->
        <Label Content="Tên hiển thị (App):" VerticalAlignment="Top" Height="30" Margin="0,45,300,0"/>
        <TextBox x:Name="txtAppName" VerticalContentAlignment="Center" Margin="120,45,0,197" Height="30"/>

        <!-- Main Class (có package) -->
        <Label Content="Main Class:" VerticalAlignment="Top" Height="30" Margin="0,82,300,0"/>
        <TextBox x:Name="txtMainClass" VerticalContentAlignment="Center" Text="MainApp" Height="30" VerticalAlignment="Top" Margin="120,82,0,0"/>

        <!-- Main Class (có package) -->
        <Label Content="Author" VerticalAlignment="Top" RenderTransformOrigin="0.525,3.391" Height="30" Margin="0,120,300,0"/>
        <TextBox x:Name="txtAuthor" VerticalContentAlignment="Center" Margin="120,119,0,0" Text="python IDE" Height="30" VerticalAlignment="Top"/>
        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,173,0,64" Width="256">
            <Button Content="OK" Width="80" Height="30" IsDefault="True" Click="BtnOk_Click" Margin="0,0,100,0"/>
            <Button Content="Hủy" Width="76" Height="30" IsCancel="True" Click="BtnCancel_Click" RenderTransformOrigin="3.434,0.853" HorizontalAlignment="Right" Panel.ZIndex="0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>