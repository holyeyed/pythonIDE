<Window x:Class="PythonEditor.InputNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog" Height="160" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#D4D4D4">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề hướng dẫn -->
        <TextBlock x:Name="lblPrompt" Text="Nhập tên:" Foreground="#D4D4D4" Margin="0,0,0,5"/>

        <!-- Ô nhập text -->
        <TextBox x:Name="txtInput" Grid.Row="1" Background="#2D2D2D" Foreground="#D4D4D4" 
                 BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0" FontSize="13"/>

        <!-- Nút bấm OK / Cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Height="26" Margin="0,0,8,0" Click="BtnOk_Click" 
                    IsDefault="True" Background="#007ACC" Foreground="White" BorderBrush="{x:Null}"/>
            <Button Content="Hủy" Width="75" Height="26" Click="BtnCancel_Click" 
                    IsCancel="True" Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="{x:Null}"/>
        </StackPanel>
    </Grid>
</Window>