<Window x:Class="PythonEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:PythonEditor"
        Title="python Mini IDE - Native Toolchain" Height="700" Width="1000"
        WindowState="Maximized"
        Background="#1E1E1E" Foreground="#D4D4D4">

    <Grid>
        <!-- 👉 Chia tổng thể cửa sổ thành 2 hàng: Hàng trên chứa Code+Tree, Hàng dưới chứa Log Output -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Chiếm toàn bộ không gian còn lại -->
            <RowDefinition Height="150" MinHeight="80" />
            <!-- Chiều cao cố định ban đầu cho khung Output, có thể kéo giãn -->
        </Grid.RowDefinitions>

        <!-- ================= HÀNG 0: PHẦN LÀM VIỆC CHÍNH (Cây thư mục + Cấu hình + Trình soạn thảo) ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. CỘT TRÁI: Project Explorer (Trên) & App Config (Dưới) -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text=" PROJECT EXPLORER" Background="#2D2D2D" Foreground="#CCCCCC" Padding="6" FontWeight="Bold" FontSize="11" DockPanel.Dock="Top"/>
                        <TreeView x:Name="tvProject" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="{x:Null}">
                            <TreeView.Resources>
                                <!-- Style ép màu nền tối cho TreeViewItem và xử lý hiệu ứng hover/select -->
                                

                                <!-- Template phân cấp cây dữ liệu -->
                                <HierarchicalDataTemplate DataType="{x:Type local:ProjectNodeModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Image Width="16" Height="16" Margin="0,0,5,0" Source="{Binding IconPath}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#D4D4D4"/>
                                        <StackPanel.ContextMenu >
                                            <ContextMenu Background="White" Foreground="Black">
                                                <MenuItem Header="New File..." Click="Menu_NewFile_Click" Foreground="Black"/>
                                                <MenuItem Header="Rename" Click="Menu_Rename_Click" Foreground="Black"/>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="Menu_Delete_Click" Foreground="#C62828" FontWeight="SemiBold"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                    </StackPanel>
                                    
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>

                    <!-- Bảng cấu hình ứng dụng -->
                    <Border Grid.Row="1" Background="#2D2D2D" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text=" APP CONFIGURATION" Foreground="#CCCCCC" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App Name:" Foreground="#9CDCFE" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtAppName" Grid.Column="1" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555" Padding="3,2"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Main Class:" Foreground="#9CDCFE" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtMainClass" Grid.Column="1" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555" Padding="3,2"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Author:" Foreground="#9CDCFE" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtAuthor" Grid.Column="1" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555" Padding="3,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333" Cursor="SizeWE"/>

            <!-- 2. CỘT PHẢI: Toolbar + Khung soạn thảo AvalonEdit -->
            <Border Grid.Column="2" Background="#1E1E1E">

                <!-- Đặt ngay đầu DockPanel trong Border Grid.Column="2" -->
               
                <DockPanel>
                    <Menu DockPanel.Dock="Top" Background="#1E1E1E" Foreground="#D4D4D4"
      BorderBrush="#333337" BorderThickness="0,0,0,1" Padding="4,2">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                                                        <ColumnDefinition Width="12"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ContentPresenter x:Name="Icon" Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>

                                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>

                                                    <TextBlock x:Name="IGT" Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#858585"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"/>

                                                    <Path x:Name="Glyph" Grid.Column="3"
                                      Data="M 0,0 L 4,3.5 L 0,7 Z"
                                      Fill="#9D9D9D"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                                    <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       HorizontalOffset="-1"
                                       VerticalOffset="1"
                                       PopupAnimation="Fade"
                                       Focusable="False">
                                                        <!-- Nền tổng của menu xổ xuống -->
                                                        <Border Background="#1E1E1E"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            Padding="0"
                                            SnapsToDevicePixels="True">
                                                            <StackPanel Background="#1E1E1E"
                                                    IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Role" Value="TopLevelHeader">
                                                    <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                                </Trigger>
                                                <Trigger Property="Role" Value="SubmenuHeader">
                                                    <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#6A6A6A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="Separator">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Background="#1E1E1E" Padding="4,2">
                                                <Rectangle Height="1" Fill="#383838"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>

                        <MenuItem Header="Format">
                            <MenuItem Header="Indent Selection (4 Spaces)" Click="MenuFormat_Indent_Click"/>
                            <MenuItem Header="Unindent Selection" Click="MenuFormat_Unindent_Click"/>
                            <Separator/>
                            <MenuItem Header="Tabs to 4 Spaces" Click="MenuFormat_TabsToSpaces_Click"/>
                            <MenuItem Header="Trim Trailing Whitespace" Click="MenuFormat_TrimTrailing_Click"/>
                            <Separator/>
                            <MenuItem Header="Toggle Comment (#)" Click="MenuFormat_ToggleComment_Click"/>
                        </MenuItem>
                    </Menu>
                    <!-- Xóa bỏ Padding khỏi thẻ Grid -->
                    <Grid DockPanel.Dock="Top" Background="#2D2D2D" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Cụm nút bấm bên trái (thêm Margin vào đây nếu muốn tạo khoảng cách lề) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                            <Button x:Name="btnNewProject" Click="BtnNewProject_Click" Content=" ➕ New " Background="#333333" Foreground="White" BorderBrush="#555" Padding="6,4" Margin="2,0"/>
                            <Button x:Name="btnCloseProject" Click="BtnCloseProject_Click" Content=" ❌ Close " Background="#333333" Foreground="White" BorderBrush="#555" Padding="6,4" Margin="2,0"/>
                            <Separator Background="#555" Margin="4,2"/>
                            <Button x:Name="btnSave" Click="BtnSave_Click" Content=" 💾 Lưu " Background="#333333" Foreground="White" BorderBrush="#555" Padding="6,4" Margin="2,0"/>
                            <Separator Background="#555" Margin="4,2"/>
                            <Button x:Name="btnBuildRun" Click="BtnBuildRun_Click" Content=" ▶ Build &amp; Run " Background="#007ACC" Foreground="White" FontWeight="Bold" BorderBrush="#007ACC" Padding="10,4" Margin="2,0"/>
                            <Button x:Name="btnStop"
        Content="■ Stop"
        Click="BtnStop_Click"
        IsEnabled="False"
        Background="#C62828"
        Foreground="White"
        BorderThickness="0"
        Padding="12,6"
        Margin="6,0,0,0"/>
                            <Separator Background="#555" Margin="4,2"/>
                            <Button x:Name="btnPipInstall" Click="BtnPipInstall_Click" Content=" 📦 Pip Install " Background="#2E7D32" Foreground="White" BorderBrush="#388E3C" Padding="8,4" Margin="2,0"/>
                        </StackPanel>

                        <!-- Tên file đang mở ở góc phải -->
                        <TextBlock x:Name="txtCurrentFileName" Grid.Column="1" Text="No file opened" 
               Foreground="#858585" VerticalAlignment="Center" HorizontalAlignment="Right" 
               Margin="0,0,15,0" FontStyle="Italic" FontSize="12"/>
                    </Grid>

                    <!-- Khung soạn thảo AvalonEdit -->
                    <avalonEdit:TextEditor x:Name="codeEditor" 
                               FontFamily="Consolas" 
                               FontSize="13" 
                               Background="#1E1E1E" 
                               Foreground="#D4D4D4"
                               ShowLineNumbers="True"
                               SyntaxHighlighting="Java" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Thanh phân tách chiều dọc giữa Khung Code và Khung Output -->
        <GridSplitter Grid.Row="0" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#333333" Cursor="SizeNS"/>

        <!-- ================= HÀNG 1: KHUNG OUTPUT / LOGS Ở PHÍA DƯỚI ================= -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text=" BUILD OUTPUT / LOGS" Background="#2D2D2D" Foreground="#CCCCCC" Padding="6,3" FontWeight="Bold" FontSize="10" DockPanel.Dock="Top"/>

                <TextBox x:Name="txtOutput"
         IsReadOnly="True"
         TextWrapping="Wrap"
         AcceptsReturn="True"
         VerticalScrollBarVisibility="Auto"
         Background="#141414"
         Foreground="#CCCCCC"
         CaretBrush="White"
         FontFamily="Consolas"
         FontSize="12"
         Padding="8"
         BorderThickness="0"
         PreviewKeyDown="TxtOutput_PreviewKeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>