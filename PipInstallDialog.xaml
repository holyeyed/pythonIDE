<Window x:Class="PythonEditor.PipInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIP Package Installer" Height="420" Width="560"
        WindowStartupLocation="CenterOwner" MinHeight="280" MinWidth="420"
        Background="#1E1E1E" Foreground="#D4D4D4">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hàng 0: "pip install " + TextBox + Nút Install -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="pip install " FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                       Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,4,0"/>

            <TextBox x:Name="txtPackageName" Grid.Column="1"
                     Background="#2D2D2D" Foreground="White" CaretBrush="White"
                     BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="6,0"
                     FontFamily="Consolas" FontSize="13" KeyDown="TxtPackageName_KeyDown"/>

            <Button x:Name="btnInstall" Grid.Column="3" Content="Install" Width="85"
                    Click="BtnInstall_Click" Background="#007ACC" Foreground="White"
                    FontWeight="SemiBold" BorderBrush="{x:Null}"/>
        </Grid>

        <!-- Hàng 2: Khung Output log ngay trong cửa sổ Install -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="#333337" BorderThickness="1" CornerRadius="3">
            <TextBox x:Name="txtInstallOutput"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     Foreground="#CCCCCC"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     BorderThickness="0"/>
        </Border>

        <!-- Hàng 4: Nút đóng cửa sổ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Content="Close" Width="80" Height="28"
                    Click="BtnClose_Click" Background="#3F3F46" Foreground="#D4D4D4"
                    BorderBrush="{x:Null}"/>
        </StackPanel>
    </Grid>
</Window>